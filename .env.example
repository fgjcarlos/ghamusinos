# Entorno de ejecución: development | production
ENV=development

# Puerto TCP del servidor HTTP
PORT=8080

# ─── Base de datos ─────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD no tiene valor por defecto: debe definirse explícitamente.
# En staging/prod genera contraseñas aleatorias (p. ej. openssl rand -base64 32).
# Si la contraseña contiene caracteres reservados de URL (@, /, :, #), define
# DATABASE_URL manualmente con el valor URL-encodeado.
POSTGRES_USER=ghamusinos
POSTGRES_PASSWORD=
POSTGRES_DB=ghamusinos

# Cadena de conexión a PostgreSQL (OBLIGATORIA)
DATABASE_URL=postgres://${POSTGRES_USER}:***@localhost:5432/${POSTGRES_DB}?sslmode=disable

# ─── Seguridad HTTP (issue #26) ──────────────────────────────────────────────
# Strict-Transport-Security. Activar SOLO detrás de un proxy TLS.
# SECURITY_HSTS_ENABLED=true
# Modo report-only para Content-Security-Policy (monitorizar sin romper).
# SECURITY_CSP_REPORT_ONLY=false
# Límite global del cuerpo HTTP en bytes (default 10 MiB = 10485760).
# MAX_BODY_BYTES=10485760

# ─── Pool de PostgreSQL (pgxpool) ──────────────────────────────────────────
# Sobrescriben los valores por defecto de db.DefaultPoolConfig().
# Formato de duración Go: "5s", "1h30m", "500ms", etc.

# Tamaño máximo del pool. Default 20.
DB_POOL_MAX_CONNS=20
# Tamaño mínimo (warm pool). Default 2. Debe ser 0 ≤ n ≤ DB_POOL_MAX_CONNS.
DB_POOL_MIN_CONNS=2
# Tiempo máximo de vida de una conexión. Default 1h.
DB_POOL_MAX_CONN_LIFETIME=1h
# Tiempo máximo de inactividad de una conexión. Default 30m.
DB_POOL_MAX_CONN_IDLE_TIME=30m
# Timeout para establecer una conexión TCP nueva. Default 5s.
# Recomendado SIEMPRE > 0 para evitar arranques colgados.
DB_POOL_CONNECT_TIMEOUT=5s
# DB_POOL_HEALTH_CHECK_PERIOD=1m

# ─── Clerk (obligatorio) ───────────────────────────────────────────────────────
# CLERK_JWKS_URL es la URL del endpoint JWKS de tu instancia de Clerk.
# La encontrarás en el dashboard de Clerk → API Keys → "Show JWT public key".
# Ejemplo de development instance: https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# CLERK_ISSUER es el emisor del claim `iss` de los tokens que emite Clerk.
# Validar el emisor es la única forma de impedir que un token firmado por una
# clave del JWKS configurado entre sin pertenecer al tenant. La URL sale del
# mismo sitio que CLERK_JWKS_URL. Issue #167.
CLERK_ISSUER=
# CLERK_AUDIENCE es el valor esperado del claim `aud` (opcional). Si lo
# defines en el dashboard de Clerk, ponlo aquí; si no, déjalo vacío.
# CLERK_AUDIENCE=

# ─── Auth (solo desarrollo local) ────────────────────────────────────────────
# Bypass del middleware de Clerk + invite gate. Cuando vale true, el grupo
# /api/* se sirve con un usuario sintético (email dev@local, status active)
# y NO se valida ningún JWT. Pensado para levantar el stack y validar
# endpoints por Tailscale antes de configurar el dashboard de Clerk.
#
# ⚠️  NUNCA activar en staging/prod: el log emite WARN pero el bypass
# sigue activo. Default: false.
# Valores aceptados: 1, true, yes, on (case-insensitive).
# AUTH_DISABLED=true

# ─── Frontend y proxy ──────────────────────────────────────────────────────
# FRONTEND_URL es el origen del SPA. Se usa en redirecciones OAuth, enlaces
# CORS, links de invitación y URLs absolutas construidas desde el backend.
# Por defecto: http://localhost:5173 (Vite dev server).
# En producción debe casar con el dominio público (sin barra final).
# FRONTEND_URL=http://localhost:5173

# TRUSTED_PROXIES lista los rangos CIDR de proxies/load balancers en los que
# el servidor confía para reenviar cabeceras X-Forwarded-For y X-Real-IP.
# Lista separada por comas. Vacío por defecto: las cabeceras de proxy se
# ignoran (cliente siempre = peer TCP directo). Configurar en cualquier
# despliegue detrás de Nginx, Traefik, Caddy, Cloudflare, etc.
# Ejemplo: TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32,172.16.0.0/12

# ─── Strava (opcional; integración activa si CLIENT_ID y CLIENT_SECRET están definidas) ─
# STRAVA_CLIENT_ID y STRAVA_CLIENT_SECRET son las credenciales de la app de Strava,
# disponibles en https://www.strava.com/settings/api tras crear tu app. Si están
# vacías, los handlers OAuth no se montan y la integración queda inactiva.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# STRAVA_CIPHER_KEY es la clave AES-256-GCM (32 bytes) en base64 estándar, usada
# para cifrar los tokens persistidos de Strava. OBLIGATORIA si ID/SECRET están
# definidas. Genera una con: openssl rand -base64 32
# STRAVA_CIPHER_KEY=

# STRAVA_WEBHOOK_VERIFY_TOKEN es el token de suscripción para el handshake de
# webhooks de Strava. OBLIGATORIA si ID/SECRET están definidas. Sale del
# callback que Strava hace cuando creas la suscripción del webhook.
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# STRAVA_REDIRECT_URL es la URL de redirección OAuth (debe coincidir con la
# configurada en la app de Strava). Por defecto el endpoint es local.
# Ejemplo: STRAVA_REDIRECT_URL=http://localhost:8080/api/strava/oauth/callback
# STRAVA_REDIRECT_URL=

# STRAVA_SCOPES son los scopes OAuth solicitados, separados por coma. El default
# "read,activity:read" da acceso a perfil y actividades. Cambiar solo si se
# necesitan más (p. ej. "read,activity:read,activity:write").
# STRAVA_SCOPES=read,activity:read

# STRAVA_BACKFILL_DAYS es el número de días hacia atrás para la sincronización
# inicial de actividades. Default 42 (~6 semanas). Razonable entre 7 y 365.
# STRAVA_BACKFILL_DAYS=42
